{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-6.1-sol",
    "share": "disabled",
    "agents": {
        "title": {
            "model": "openai/gpt-6-luna"
        }
    },
    "permissions": [
        {
            "action": "*",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "git status*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git diff*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git log*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git show*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "ask"
        }
    ],
    "providers": {
        "openai": {
            "settings": {
                "chunkTimeout": 300000,
                "headerTimeout": false,
                "timeout": false
            },
            "models": {
                "gpt-6.1-sol": {
                    "settings": {
                        "reasoningEffort": "xhigh"
                    }
                }
            }
        }
    }
}
