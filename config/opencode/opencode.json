{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-5.6-sol",
    "small_model": "openai/gpt-5-mini",
    "share": "disabled",
    "permission": {
        "*": "allow",
        "bash": {
            "*": "ask",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git show*": "allow"
        },
        "external_directory": "ask",
        "doom_loop": "ask"
    },
    "provider": {
        "openai": {
            "options": {
                "chunkTimeout": 300000,
                "headerTimeout": false,
                "timeout": false
            }
        }
    }
}
